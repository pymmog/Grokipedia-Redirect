{
  "manifest_version": 3,
  "name": "Grokipedia Redirect",
  "version": "1.2.1",
  "description": "Opens Wikipedia article links in Grokipedia, with fallback to Wikipedia when missing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Grokipedia Redirect",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.wikipedia.org/*",
    "*://wikipedia.org/*",
    "https://grokipedia.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.wikipedia.org/*",
        "*://wikipedia.org/*"
      ],
      "js": ["url-utils.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://grokipedia.com/page/*"],
      "js": ["url-utils.js", "grokipedia-fallback.js"],
      "run_at": "document_start"
    }
  ]
}
